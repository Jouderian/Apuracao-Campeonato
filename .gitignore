*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Microsoft Access — bancos brutos (proteção LGPD) e arquivos de lock
*.mdb
*.accdb
*.ldb
*.laccdb

# Resultado parcial (não oficial): PDF regenerável a cada apuração, não é versionado
Dados/*/resultados/resultadoParcial*.pdf

# Resultado de clubes e apuração do ano corrente (aguarda autorização formal da FECORI antes de divulgar)
Dados/2026/resultados/resultadoClubesCCO.*
Dados/2026/resultados/apuracaoCampeonato2026.xlsx

# Base SQLite de análise de desempenho: derivada e reconstruível a partir dos JSON (ADR-009)
Dados/analise/*.sqlite
Dados/analise/*.sqlite.tmp

# Arquivos temporários de Office e sistema
~$*.doc
~$*.docx
~$*.xlsx
~$*.pdf
*.tmp
*.bak
Thumbs.db
Desktop.ini
.DS_Store

